# Public URL for an HTTPS enquiry API. No secret keys belong in VITE_ variables.
VITE_ENQUIRY_ENDPOINT=
# Consultancy defaults to the bundled /consultancy/ portfolio; set only for an external override.
VITE_CONSULTANCY_URL=
# Workshops defaults to the bundled /workshop/ app; set only for an external override.
VITE_WORKSHOPS_URL=
# Optional workshop-specific enquiry API. Leave empty to prepare email drafts locally.
VITE_WORKSHOP_ENQUIRY_ENDPOINT=
