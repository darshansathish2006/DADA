# Optional override for the active Apps Script endpoint in src/contact-details.js.
# Main, consultancy and workshop forms share the configured public /exec URL.
# Leave empty to use the team's deployed script; see apps-script/README.md.
# To override on GitHub Pages, set the same GitHub Actions repository variable.
# This is a public endpoint. Never put Gmail passwords or tokens in VITE_ variables.
VITE_ENQUIRY_ENDPOINT=
# Consultancy defaults to the bundled /consultancy/ portfolio; set only for an external override.
VITE_CONSULTANCY_URL=
# Workshops defaults to the bundled /workshop/ app; set only for an external override.
VITE_WORKSHOPS_URL=
# Optional workshop-only override. Leave empty to use VITE_ENQUIRY_ENDPOINT.
VITE_WORKSHOP_ENQUIRY_ENDPOINT=
